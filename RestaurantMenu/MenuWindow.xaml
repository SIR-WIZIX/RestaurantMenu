<Window x:Class="RestaurantMenu.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр меню" Height="400" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Фильтр блюд: " VerticalAlignment="Center"/>
            <ComboBox x:Name="CategoryFilterComboBox" Width="120" Height="20" Margin="5,0,0,0" 
                      SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Margin="250,0,0,10">
            <TextBlock Text="Название:"/>
            <TextBox x:Name="DishNameTextBox" Width="200" Margin="0,5,0,10"/>

            <TextBlock Text="Цена:"/>
            <TextBox x:Name="DishPriceTextBox" Width="200" Margin="0,5,0,10"/>

            <TextBlock Text="Категория:"/>
            <TextBox x:Name="DishCategoryTextBox" Width="200" Margin="0,5,0,10"/>
        </StackPanel>


        <DataGrid x:Name="MenuDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn  Header="Название" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:C}}" Width="1*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Добавить" Width="80" Click="AddButton_Click"/>
                <Button Content="Удалить" Width="80" Margin="5,0,0,0" Click="DeleteButton_Click"/>
                
                <Button Content="Очистить меню" 
                        Width="110" 
                        Margin="5,0,0,0" 
                        Background="#FFF17676" 
                        Click="ClearMenuButton_Click"/>
            </StackPanel>
            
            <Button Content="Сохранить" Width="80" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="SaveButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
