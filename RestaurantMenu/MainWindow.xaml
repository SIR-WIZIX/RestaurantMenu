<Window x:Class="RestaurantMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главное меню — Выбор заведения" Height="450" Width="450" 
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Управление меню ресторанов" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Выберите тип заведения:" Margin="0,5,0,2"/>
            <ComboBox x:Name="TypeFilterComboBox" SelectionChanged="TypeFilterComboBox_SelectionChanged" Margin="0,0,0,10"/>

            <TextBlock Text="Выберите заведение:" Margin="0,5,0,2"/>
            <ComboBox x:Name="EstablishmentComboBox" SelectionChanged="EstablishmentComboBox_SelectionChanged" Margin="0,0,0,10"/>

            <StackPanel x:Name="NewEstablishmentPanel" Visibility="Collapsed" Margin="0,10,0,10">

                <TextBlock Text="Название нового заведения:"/>
                <TextBox x:Name="NewEstablishmentNameTextBox" Margin="0,0,0,10"/>

                <TextBlock Text="Адрес нового заведения:"/>
                <TextBox x:Name="NewEstablishmentAddressTextBox" Margin="0,0,0,10"/>

                <TextBlock Text="Тип (Restaurant / Cafe / CoffeeShop):"/>
                <ComboBox x:Name="NewEstablishmentTypeComboBox" Margin="0,0,0,10"/>


                <Button Content="Добавить заведение" Height="30"
            Click="AddEstablishmentButton_Click"/>
            </StackPanel>

            <TextBlock Text="Вид меню:" Margin="0,5,0,2"/>
            <ComboBox x:Name="MenuTypeComboBox" Margin="0,0,0,10"/>

            <TextBlock Text="Формат сохранения данных:" Margin="0,5,0,2"/>
            <ComboBox x:Name="FormatComboBox" SelectionChanged="FormatComboBox_SelectionChanged" Margin="0,0,0,10"/>

            <UniformGrid Columns="2" Margin="0,5,0,10">
                <Button Content="Сохранить в файл" Height="28" Margin="0,0,5,0" Click="SaveDatabaseButton_Click"/>
                <Button Content="Загрузить из файла" Height="28" Margin="5,0,0,0" Click="LoadDatabaseButton_Click"/>
            </UniformGrid>

            <Button x:Name="ShowMenuButton" Content="Показать меню" Height="35" Margin="0,15,0,0" 
                    IsEnabled="False" Click="ShowMenuButton_Click"/>        </StackPanel>
    </Grid>
</Window>
